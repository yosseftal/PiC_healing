{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "routes": [
    { "src": "/", "dest": "/index.html" },
    { "src": "/(?!index\\.html$|assets/).*", "status": 404 },
    { "handle": "filesystem" },
    { "src": "/.*", "status": 404 }
  ]
}
