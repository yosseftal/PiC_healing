{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "rootDir": "src",
    "outDir": "dist",
    // Scoped to this package only (mirrors pic-engine/tsconfig.json's identical note): this package's own
    // src/index.ts uses `crypto.randomUUID()` (a global ambient type, not covered by "lib": ["ES2022"]
    // alone), and its co-located test file uses `node:fs`/`node:url`/`import.meta.url`. Because there is
    // no TS project-references build here, a single-package `tsc --noEmit` run also type-checks whatever
    // it transitively imports (e.g. pic-engine's own `crypto.randomUUID()` call sites) under *this*
    // package's compiler options - so this package needs the same "node" types pic-engine already has.
    "types": ["node"]
  },
  "include": ["src"]
}
